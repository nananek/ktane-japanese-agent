# Discord Bot
DISCORD_TOKEN=

# LLM (OpenAI互換API)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 呼び出すAPI: chat (Chat Completions、既定) / responses (Responses API)。モデルが対応する方を指定
LLM_API=chat
# 応答待ちのタイムアウト秒数。超えたら言い直しを促す
LLM_TIMEOUT=30
# 思考型モデルの思考量 (low / medium / high など、省略可)。長考で応答が遅れる場合は low を推奨
LLM_REASONING_EFFORT=low
# 追加HTTPヘッダー (JSONオブジェクト、省略可)。値中の {session_id} は爆弾セッションごとのUUIDに置換される
# 例: LLM_HEADERS={"User-Agent": "ktane-japanese-agent/0.1", "x-session-id": "{session_id}"}
LLM_HEADERS=

# VOICEVOX ENGINE (ローカルHTTPサーバー)
VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=3
# 話速 (1.0が標準、大きいほど速い)
VOICEVOX_SPEED_SCALE=1.3

# faster-whisper
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
