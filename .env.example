# Discord Bot
DISCORD_TOKEN=

# LLM (OpenAI互換API)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 追加HTTPヘッダー (JSONオブジェクト、省略可)。値中の {session_id} は爆弾セッションごとのUUIDに置換される
# 例: LLM_HEADERS={"User-Agent": "ktane-japanese-agent/0.1", "x-session-id": "{session_id}"}
LLM_HEADERS=

# VOICEVOX ENGINE (ローカルHTTPサーバー)
VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=3

# faster-whisper
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
